# Copia a .env y ajusta. NUNCA commitees .env.
POSTGRES_USER=presencia
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=presencia
POSTGRES_PORT=5432
# Puerto del host donde el contenedor `app` publica su 3000 (solo prod, solo
# loopback). No definas PORT: el lado del contenedor tiene que seguir en 3000.
# APP_PORT=3001

# Conexión de migraciones — rol owner (apunta al compose local o al túnel SSH del VPS)
DATABASE_URL=postgres://presencia:cambia-esto@localhost:5432/presencia

# Conexión del runtime de la API — rol presencia_app, sujeto a RLS (ADR-003).
# El password NO viene en las migraciones; asígnalo una vez por entorno:
#   ALTER ROLE presencia_app WITH PASSWORD 'cambia-esto-tambien';
APP_DATABASE_URL=postgres://presencia_app:cambia-esto-tambien@localhost:5432/presencia

# Conexión de la cola de jobs (pg-boss, ADR-008) — rol presencia_jobs, dueño
# único del schema pgboss (migración 0020). Mismo rol en dev y en prod: pg-boss
# migra sus propias tablas al arrancar y eso exige ser su dueño. Una vez por
# entorno:
#   ALTER ROLE presencia_jobs WITH PASSWORD 'otro-password-distinto';
JOBS_DATABASE_URL=postgres://presencia_jobs:otro-password-distinto@localhost:5432/presencia

# Better Auth (ADR-007). Genera el secret con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambia-esto-32-chars-minimo-aleatorio
BETTER_AUTH_URL=http://localhost:3000
WEB_URL=http://localhost:5173

# IA multi-proveedor (ADR-004). Modelos en formato proveedor:modelo —
# cambiarlos requiere reiniciar el proceso. Cada modelo de cada variable
# necesita la key de su proveedor (la API no arranca si falta; las de
# AI_MODEL_IMAGE, solo con IMAGE_PROVIDER=real); las keys de
# proveedores que no aparecen en ninguna variable sobran.
# Esfuerzo de razonamiento (F10.7, opcional): proveedor:modelo@esfuerzo, con
# none | minimal | low | medium | high | xhigh. Sin @, el default del
# proveedor. Si el modelo no tiene ese nivel, el SDK usa el más cercano y lo
# avisa en el log. No vale en los modelos de imagen.
# Cadena de respaldo (F10.7): principal y respaldos separados por coma, cada
# uno con su @esfuerzo. Solo cae al siguiente si el proveedor se cae (5xx,
# timeout, red, 429, sin saldo), nunca por un 400.
# Routing por tarea (F4.5): cada tarea de texto usa CHAT, UTILITY o ADAPT.
# AI_MODEL es solo la red: el modelo de cualquiera de esas tres que quede sin
# setear. Con las tres puestas no lo usa ninguna tarea; en prod conviene que
# sea la misma cadena del chat, para que una variable faltante caiga en un
# modelo con respaldo. Aquí, Gemini: arranca con la key gratis de Google.
AI_MODEL=google:gemini-3.6-flash
# AI_MODEL_CHAT=openai:gpt-6-luna@high,google:gemini-3.8-flash@medium,anthropic:claude-sonnet-5-5
# AI_MODEL_UTILITY=openai:gpt-6-luna@low,google:gemini-3.8-flash@low
# AI_MODEL_ADAPT=openai:gpt-6-luna@high,google:gemini-3.8-flash@medium
# Solo dev: finge caídos esos proveedores (503) para ver el respaldo en el
# navegador. Con `pnpm dev` (turbo) ponlo aquí; turbo no pasa variables del
# proceso a la API.
# AI_FALLBACK_SIMULATE=openai
# Chats largos (F10.8): a partir de cuántos tokens de entrada se compacta el
# tramo viejo del chat con el modelo utility (default 40000, ~1% de la cuota
# Creator por mensaje), y el techo de lo que viaja aunque el resumen no haya
# corrido (default 120000). Bájalo en dev para probar la compactación.
# CHAT_COMPACT_AT_TOKENS=40000
# CHAT_HISTORY_CAP_TOKENS=120000
# Tendencias de Ritmo (F9). NO cae a AI_MODEL: necesita búsqueda web con
# grounding, que hoy solo da Google, así que sin setear usa un modelo de
# Google. Desde F10.7 acepta cadena de respaldo, pero solo de modelos de
# Google: con otro proveedor la API no arranca, en vez de producir tendencias
# sin fuente (ADR-023).
# AI_MODEL_TRENDS=google:gemini-3.8-flash,google:gemini-3.6-flash
# Imágenes (F10, ADR-025). Tampoco cae a AI_MODEL: un modelo de texto no
# dibuja. Sin setear usa Gemini 3.1 Flash Image. IMAGE_PROVIDER=fake dibuja
# un PNG liso sin llamar a nadie (para probar la card sin gastar).
# Desde F10.7 AI_MODEL_IMAGE es cadena de respaldo, como las de texto (sin
# @esfuerzo): si el principal se cae, dibuja el siguiente. Un bloqueo de
# contenido nunca pasa al siguiente.
# El primero es el principal; "Probar con otro generador" ofrece los demás
# (Generador 2, 3…), sin decir qué modelo es cada uno. Con uno solo, el botón
# no aparece. AI_MODEL_IMAGE_ALT está obsoleta pero se sigue leyendo: si
# quedó puesta, entra 2ª en esta lista (y empuja al que estaba ahí) con un
# aviso en el log. Muévela a la lista y bórrala.
# El orden de prod sale del bake-off de F10.7 (ADR-025): gpt-image-2 primero
# (misma calidad a la mitad del costo y sin logotipos), Nano Banana 2 después.
# AI_MODEL_IMAGE=openai:gpt-image-2,google:gemini-3.1-flash-image
# IMAGE_PROVIDER=real
# Con el fake: cuánto tarda en "dibujar" (ms), para ver el estado generando.
# IMAGE_FAKE_DELAY_MS=6000
# Gemini — key gratis en https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=tu-api-key
# OpenAI (opcional) — https://platform.openai.com/api-keys
# OPENAI_API_KEY=tu-api-key
# Anthropic/Claude (opcional; obligatoria si Sonnet está en la cadena del
# chat) — https://console.anthropic.com
# ANTHROPIC_API_KEY=tu-api-key
# DeepSeek (opcional; fuera de las cadenas desde F10.7: datos en China y 400
# por reasoning_content en un historial mixto) — https://platform.deepseek.com
# DEEPSEEK_API_KEY=tu-api-key
# MiniMax (opcional, API compatible con OpenAI) — https://api.minimax.io
# MINIMAX_API_KEY=tu-api-key
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# Kimi/Moonshot (opcional, API compatible con OpenAI) — https://platform.moonshot.ai
# KIMI_API_KEY=tu-api-key
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# xAI (opcional, Grok Imagine para imágenes, F10.7) — https://console.x.ai
# XAI_API_KEY=tu-api-key
# OpenRouter (opcional, solo imágenes: Muse y MAI-Image con una key, F10.7) —
# https://openrouter.ai/keys. Una key por ambiente, con límite de crédito.
# OPENROUTER_API_KEY=tu-api-key

# Correo transaccional — Zoho ZeptoMail (verificación de email)
ZEPTOMAIL_TOKEN=tu-send-mail-token
MAIL_FROM=no-reply@tu-dominio.mx

# Publicación (F6/F7.5, ADR-009). "fake" (default) no necesita key — es el
# provider permanente de dev/test, no un andamio temporal. Los otros dos
# hablan con una API real y cada uno exige SU key al boot (fail-fast).
#
#   fake         in-memory, sin red
#   postfast     api.postfa.st — workspace único y global (ver ADR-009)
#   upload_post  api.upload-post.com — un perfil por usuario de Presencia
#                (el único con publicación real verificada, F7.5)
#
# Las *_BASE_URL solo hacen falta si el proveedor cambia de host: env.ts ya
# trae el default correcto de cada uno.
PUBLISHING_PROVIDER=fake
# POSTFAST_API_KEY=tu-api-key-de-workspace
# POSTFAST_BASE_URL=https://api.postfa.st
# UPLOAD_POST_API_KEY=tu-api-key-de-upload-post
# UPLOAD_POST_BASE_URL=https://api.upload-post.com/api

# --- Backup diario (F8.5, ADR-011) ---
# Solo en prod: sin esto el job `backups.daily` no se registra y la API arranca
# igual (en dev nadie tiene bucket). Pero se configura COMPLETO o no se
# configura: a medias es un error de arranque, no un respaldo que se salta en
# silencio.
#
# El rol presencia_backup lo crea la migración 0021 sin password (como todos);
# se asigna por entorno. Tiene pg_read_all_data + BYPASSRLS: lee todo, sin
# escritura ni DDL.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=presencia-backups
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_REGION=auto
# BACKUP_DATABASE_URL=postgres://presencia_backup:...@postgres:5432/presencia

# --- Jobs en background (F8, ADR-008) ---
# El worker de pg-boss corre DENTRO del proceso de la API cuando esto es
# "true" (default). En dev tiene que quedarse así: FakePublishingProvider
# guarda los posts programados en memoria del proceso, y un worker aparte los
# vería como inexistentes y marcaría fallida toda card programada.
# En prod esta variable no se usa: el docker-compose.yml fija "false" en los
# dos servicios para que el valor no dependa de un .env que alguien puede
# olvidar, y quien consume la cola es el entrypoint (`node dist/worker.js`).
# WORKER_INLINE=true

# Assets de Biblioteca (F10, ADR-011). "local" guarda en disco (dev); en
# producción es obligatorio "r2", que reusa S3_ENDPOINT y las credenciales
# del backup con su propio bucket.
# ASSETS_STORAGE=local
# ASSETS_S3_BUCKET=presencia-assets
